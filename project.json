{
  "langrev": "1",
  "warnings":  [ "no-unused" ],
  "dependency-search-paths":  [ "." ],
  // Vulkan types come from the vendor package; Volk remains the runtime loader.
  "dependencies":  [ "sdl3", "vulkan" ],
  "authors":  [ "Michael Pollind" ],
  "version": "0.1.0",
  "sources":  [ "src/**" ],
  "test-sources":  [ "test/**" ],
  "build-dir": "build",
  "features":  [ 
    "RHI_VK",
    "RHI_MTL",
    "RHI_WGPU",
    "RHI_WEBGL",
    "RHI_IMGUI",
    "RHI_DX12"
 ],
  "linker-search-paths":  [ "vendor/lib", "vendor/imgui_c/lib", "vendor/volk/lib" ],
  "linked-libraries":  [ "vma", "imgui", "volk", "stdc++" ],
  "output": "build",
  "targets": {
    "rhi": {
      "type": "static-lib"
    }
  },
  "cpu": "generic",
  "opt": "O0"
}
