{
  // C3 port of rhi-odin, built side by side with the Odin tree.
  // Run from c3/ through ./build.py test and ./build.py check; the root
  // compatibility wrappers remain ../build.py c3-test and ../build.py c3-check.
  "langrev": "1",
  "warnings": [ "no-unused" ],
  "dependency-search-paths": [ ],
  "dependencies": [ ],
  "authors": [ "Michael Pollind" ],
  "version": "0.1.0",
  "sources": [ "src/**" ],
  "test-sources": [ "test/**" ],
  "build-dir": "build",
  // Ported backends (see "Backend gating" in README.md).
  "features": [ "RHI_VK", "RHI_MTL", "RHI_WGPU", "RHI_WEBGL", "RHI_IMGUI" ],
  // The vendor extern fns resolve against the local VMA/ImGui archives and
  // the C++ runtime. c3c has no per-OS link keys; these only take effect
  // when an executable is linked (`c3c test` on the host), never for the
  // static-lib cross builds of c3-check.
  "linker-search-paths": [ "vendor/vma/lib", "../vendor/imgui/lib" ],
  "linked-libraries": [ "vma", "imgui", "stdc++" ],
  "output": "build",
  "targets": {
    "rhi": {
      "type": "static-lib",
    },
  },
  "cpu": "generic",
  "opt": "O0"
}
